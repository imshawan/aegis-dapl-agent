# http://editorconfig.org
# EditorConfig for Aegis DAPL Agent
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2
insert_final_newline = true

[Makefile]
indent_style = tab
