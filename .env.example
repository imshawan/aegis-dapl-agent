PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_LOCK_DURATION_MS=600000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aegis_db

# LLM Configuration (Configure at least one API key to enable autonomous tool-calling ReAct loops)
# The agent checks for keys in fallback order: Anthropic -> OpenAI -> Gemini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration (Supports GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-1.5-pro-latest (Other options: gemini-1.5-flash-latest, gemini-pro)
LLM_QUERY_TIMEOUT_MS=30000

# Application Identity
APP_NAME=aegis-dapl-agent

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=your_github_org_or_username
GITHUB_DEFAULT_REPO=your_github_repo_name_here
AEGIS_WORKSPACE_DIR=/tmp/aegis-workspaces

# Webhook Secrets & Slack Integration
WEBHOOK_SECRET=your_webhook_secret_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here

# Webhook Authentication Access Keys (Comma-separated API keys for Sentry, Slack, CI/CD webhooks)
AEGIS_ACCESS_KEYS=aegis_live_key_99x7,aegis_test_key_00a1

# AWS Secrets Manager Integration (Zero-downtime automated key rotation in production)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_SECRETS_MANAGER_SECRET_ID=aegis/production/webhook-keys
# AWS_SECRET_POLL_INTERVAL_MS=3600000
