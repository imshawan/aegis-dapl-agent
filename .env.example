PORT=3000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_LOCK_DURATION_MS=600000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aegis_db

# LLM Configuration (Configure at least one API key to enable autonomous tool-calling ReAct loops)
# The agent checks for keys in fallback order: Anthropic -> OpenAI -> Gemini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Configuration (Supports GEMINI_API_KEY or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-1.5-pro-latest (Other options: gemini-1.5-flash-latest, gemini-pro)

# Application Identity
APP_NAME=aegis-dapl-agent

# GitHub Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=your_github_org_or_username

# Webhook Secrets & Slack Integration
WEBHOOK_SECRET=your_webhook_secret_here
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
SLACK_BOT_TOKEN=your_slack_bot_token_here
